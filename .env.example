# ============================================================
# .env.example - av-transcription Hermes profile
# ============================================================
# 这是凭据模板。复制为 .env 并填入真实值：
#   cp .env.example .env   (Git Bash / WSL)
#   copy .env.example .env (cmd)
#
# .env 已经被 .gitignore 排除，永远不要提交。
# ============================================================

MINIMAX_CN_API_KEY=<填入真实值>
HERMES_GATEWAY_TOKEN=<填入真实值>
FEISHU_APP_ID=<填入真实值>
FEISHU_APP_SECRET=<填入真实值>
FEISHU_DOMAIN=<填入真实值>
FEISHU_GROUP_POLICY=<填入真实值>
FEISHU_ALLOW_ALL_USERS=<填入真实值>

# === 关键凭据获取方式 ===
# FEISHU_APP_ID / FEISHU_APP_SECRET: 飞书开放平台 -> 应用 -> 凭证页
# FEISHU_DOMAIN: feishu (中国) 或 lark (国际)
# MINIMAX_CN_API_KEY: MiniMax 控制台 -> API Keys
# HERMES_GATEWAY_TOKEN: 运行 setup 脚本时自动生成；恢复时也自动生成新值
